<!--
Optional (IIS only -- harmless if unused on Apache/XAMPP).
Copy/merge into the repo root's web.config if you're deploying on IIS
(matches the DESKTOP-* / SQL Server environment this app was built for).

Blocks direct web access to application code, SQL migrations, and env
files, the same way deploy/.htaccess.example does for Apache.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" />
          <add segment="database" />
          <add segment="ClassModule" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <!-- Never execute PHP inside the uploads folder. -->
    <location path="Uploads">
      <system.webServer>
        <handlers>
          <clear />
          <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="File" />
        </handlers>
      </system.webServer>
    </location>
  </system.webServer>
</configuration>
